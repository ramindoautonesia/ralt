{{- $.Scratch.Add "index" slice -}}
{{- range where site.RegularPages "Type" "in" site.Params.mainSections -}}
    {{- $path := print "images/products/" .Params.coverImage -}}
    {{- $image := resources.Get $path -}}
    {{- $image := $image.Resize "250x" -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "image" $image.RelPermalink "categories" .Params.categories "contents" .Plain "link" .RelPermalink) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
